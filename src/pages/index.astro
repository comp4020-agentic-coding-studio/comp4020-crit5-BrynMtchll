---
import "../styles/global.css";
---

<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Beside</title>
    <meta
      name="description"
      content="A garden, a season, and a watering can with far too much momentum. Roots drink from the soil around a plant, never from underneath it."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${import.meta.env.BASE_URL}card.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href={import.meta.env.BASE_URL}>Home</a>
      </nav>
    </header>

    <main>
      <h1>Beside</h1>
      <canvas data-garden></canvas>
    </main>

    <script>
      import { start } from "../game/main";

      const canvas = document.querySelector("canvas[data-garden]");
      if (canvas instanceof HTMLCanvasElement) start(canvas);
    </script>
  </body>
</html>
